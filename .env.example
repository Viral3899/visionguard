# =============================================================================
# VisionGuard AI Surveillance - Configuration
# =============================================================================
# Copy this file to .env and customize values as needed.
# Keep the default host on localhost. Do not expose the dashboard to the internet.

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# -----------------------------------------------------------------------------
# Core Person Detection (YOLOv8 + ByteTrack)
# -----------------------------------------------------------------------------
MODEL_PATH=yolov8n.pt
# auto | cpu | 0 (first CUDA GPU)
DEVICE=auto
CONFIDENCE=0.50
# Comma-separated COCO classes; 0=person, 2=car, 3=motorcycle. Only class 0 counts toward people/alerts.
DETECT_CLASS_IDS=0
IMGSZ=640
MAX_FRAME_WIDTH=960
FRAME_SKIP=2
JPEG_QUALITY=72
SNAPSHOT_RETENTION_DAYS=30
EVENT_COOLDOWN_SECONDS=20

# -----------------------------------------------------------------------------
# Fire & Smoke Detection
# -----------------------------------------------------------------------------
# Path to fire detection model (place in models/ folder)
FIRE_MODEL_PATH=models/yolov8n-fire.pt
FIRE_CONFIDENCE=0.50
# Fire model classes: typically 0=fire, 1=smoke
FIRE_CLASSES=0,1

# -----------------------------------------------------------------------------
# Violence / Fight / Weapon Detection
# -----------------------------------------------------------------------------
VIOLENCE_MODEL_PATH=models/yolov8n-violence.pt
VIOLENCE_CONFIDENCE=0.50

# -----------------------------------------------------------------------------
# Anomaly Detection (Pose-based: Falls, Loitering)
# -----------------------------------------------------------------------------
ANOMALY_MODEL_PATH=yolov8n-pose.pt
ANOMALY_CONFIDENCE=0.50
ENABLE_FALL_DETECTION=true
ENABLE_LOITERING_DETECTION=true
LOITERING_TIME_SECONDS=30

# -----------------------------------------------------------------------------
# General Object Detection (COCO classes)
# -----------------------------------------------------------------------------
OBJECT_MODEL_PATH=yolov8n.pt
OBJECT_CONFIDENCE=0.50
# Comma-separated COCO class IDs to detect (empty = all classes)
# Common: 0=person, 1=bicycle, 2=car, 3=motorcycle, 5=bus, 7=truck, 14=bird, 15=cat, 16=dog, 17=horse, 18=sheep, 19=cow, 20=elephant, 21=bear, 22=zebra, 23=giraffe, 24=backpack, 25=umbrella, 26=handbag, 27=tie, 28=suitcase, 29=frisbee, 30=skis, 31=snowboard, 32=sports ball, 33=kite, 34=baseball bat, 35=baseball glove, 36=skateboard, 37=surfboard, 38=tennis racket, 39=bottle, 40=wine glass, 41=cup, 42=fork, 43=knife, 44=spoon, 45=bowl, 46=banana, 47=apple, 48=sandwich, 49=orange, 50=broccoli, 51=carrot, 52=hot dog, 53=pizza, 54=donut, 55=cake, 56=chair, 57=couch, 58=potted plant, 59=bed, 60=dining table, 61=toilet, 62=tv, 63=laptop, 64=mouse, 65=remote, 66=keyboard, 67=cell phone, 68=microwave, 69=oven, 70=toaster, 71=sink, 72=refrigerator, 73=book, 74=clock, 75=vase, 76=scissors, 77=teddy bear, 78=hair drier, 79=toothbrush
OBJECT_CLASSES=

# -----------------------------------------------------------------------------
# Telegram security alerts (optional). Per-camera telegram_enabled must also be ON.
# Only listed event types with confidence strictly greater than 75% are sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_TYPES=intrusion,fire,fire_detected,smoke,violence,weapon,knife,gun,fight,assault,fall_detected,loitering,proximity_alert,heat_source
TELEGRAM_MIN_CONFIDENCE=0.75
TELEGRAM_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------------
# TTS Voice Siren Alerts (pyttsx3 - offline Windows SAPI)
# -----------------------------------------------------------------------------
TTS_ENABLED=true
TTS_VOICE_RATE=180
TTS_VOICE_VOLUME=1.0
# Event types that trigger voice alerts
TTS_ALERT_TYPES=fire_detected,smoke,violence,weapon,fight,assault,intrusion
# Siren duration and repeat count
SIREN_DURATION_SECONDS=10
SIREN_REPEAT_COUNT=3

# -----------------------------------------------------------------------------
# Dashboard Security
# -----------------------------------------------------------------------------
# Set a strong password if accessing from LAN/internet
DASHBOARD_PASSWORD=
# Multi-user access: set a strong admin password before creating client accounts.
ADMIN_USERNAME=admin
APP_TIMEZONE=Asia/Kolkata
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Allowed origins for WebSocket (comma-separated)
ALLOWED_ORIGINS=