# =============================================================================
# VisionGuard AI Surveillance - Configuration
# =============================================================================
# Copy this file to .env and customize values as needed.
# Keep the default host on localhost. Do not expose the dashboard to the internet.

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# -----------------------------------------------------------------------------
# Core Person Detection (YOLOv8 + ByteTrack)
# -----------------------------------------------------------------------------
MODEL_PATH=yolov8n.pt
# auto | cpu | 0 (first CUDA GPU)
DEVICE=auto
CONFIDENCE=0.50
# Comma-separated COCO classes; 0=person, 2=car, 3=motorcycle. Only class 0 counts toward people/alerts.
DETECT_CLASS_IDS=0
IMGSZ=416
MAX_FRAME_WIDTH=960
FRAME_SKIP=1
JPEG_QUALITY=72
SNAPSHOT_RETENTION_DAYS=30
EVENT_COOLDOWN_SECONDS=20
INCIDENT_MIN_CONFIDENCE=0.50
INCIDENT_CONFIRMATION_FRAMES=2

# -----------------------------------------------------------------------------
# Fire & Smoke Detection
# -----------------------------------------------------------------------------
# Path to fire detection model (place in models/ folder)
FIRE_MODEL_PATH=models/yolov26-fire-smoke.pt
FIRE_CONFIDENCE=0.50
FIRE_IMGSZ=768
# A 73% predicted "fire" on a handheld box is NOT sufficient for a fire alert.
# Strict alert confidence; small flames also require multiple matching frames.
FIRE_ALERT_MIN_SCORE=0.80
SMALL_FLAME_ALERT_MIN_SCORE=0.75
# Fire model classes: typically 0=fire, 1=smoke
FIRE_CLASSES=0,1

# -----------------------------------------------------------------------------
# Violence / Fight / Weapon Detection
# -----------------------------------------------------------------------------
# Musawer14/fight_detection_yolov8: Yolo_nano_weights.pt
VIOLENCE_MODEL_PATH=models/fight-yolov8-nano.pt
VIOLENCE_CONFIDENCE=0.30
VIOLENCE_IMGSZ=768
VIOLENCE_EVERY_N_FRAMES=1
# Subh775/Threat-Detection-YOLOv8n: gun, knife, grenade, explosives
WEAPON_MODEL_PATH=models/threat-yolov8n.pt
WEAPON_CONFIDENCE=0.30
WEAPON_IMGSZ=960
WEAPON_EVERY_N_FRAMES=1
# The pretrained threat model sometimes calls windows guns and wall fixtures knives.
# Its raw output is for diagnosis only; alerts use these class-specific safety gates.
STRICT_WEAPON_POLICY=true
# True means weapon must be near a detected person (NOT good for unattended weapons).
WEAPON_REQUIRE_PERSON=true
WEAPON_PERSON_MARGIN=0.08
WEAPON_GUN_MIN_SCORE=0.85
WEAPON_KNIFE_MIN_SCORE=0.75
WEAPON_OTHER_MIN_SCORE=0.90
# Max fraction of frame covered by a predicted gun / knife / other threat.
WEAPON_GUN_MAX_AREA=0.15
WEAPON_KNIFE_MAX_AREA=0.10
WEAPON_OTHER_MAX_AREA=0.12

# -----------------------------------------------------------------------------
# Anomaly Detection (Pose-based: Falls, Loitering)
# -----------------------------------------------------------------------------
ANOMALY_MODEL_PATH=yolov8n-pose.pt
ANOMALY_CONFIDENCE=0.50
ENABLE_FALL_DETECTION=true
ENABLE_LOITERING_DETECTION=false
LOITERING_TIME_SECONDS=30

# -----------------------------------------------------------------------------
# General Object Detection (COCO classes)
# -----------------------------------------------------------------------------
OBJECT_MODEL_PATH=yolov8n.pt
OBJECT_CONFIDENCE=0.50
OBJECT_IMGSZ=960
OBJECT_EVERY_N_FRAMES=1
# Slow but useful for small knives: scans overlapping quarters of each frame.
KNIFE_TILE_SCAN=false
# Comma-separated COCO class IDs to detect (empty = all classes)
# Common: 0=person, 1=bicycle, 2=car, 3=motorcycle, 5=bus, 7=truck, 14=bird, 15=cat, 16=dog, 17=horse, 18=sheep, 19=cow, 20=elephant, 21=bear, 22=zebra, 23=giraffe, 24=backpack, 25=umbrella, 26=handbag, 27=tie, 28=suitcase, 29=frisbee, 30=skis, 31=snowboard, 32=sports ball, 33=kite, 34=baseball bat, 35=baseball glove, 36=skateboard, 37=surfboard, 38=tennis racket, 39=bottle, 40=wine glass, 41=cup, 42=fork, 43=knife, 44=spoon, 45=bowl, 46=banana, 47=apple, 48=sandwich, 49=orange, 50=broccoli, 51=carrot, 52=hot dog, 53=pizza, 54=donut, 55=cake, 56=chair, 57=couch, 58=potted plant, 59=bed, 60=dining table, 61=toilet, 62=tv, 63=laptop, 64=mouse, 65=remote, 66=keyboard, 67=cell phone, 68=microwave, 69=oven, 70=toaster, 71=sink, 72=refrigerator, 73=book, 74=clock, 75=vase, 76=scissors, 77=teddy bear, 78=hair drier, 79=toothbrush
OBJECT_CLASSES=

# -----------------------------------------------------------------------------
# Telegram security alerts (optional). Per-camera telegram_enabled must also be ON.
# Listed suspicious event types at confidence >= 50% are sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_TYPES=fire_detected,smoke,violence,weapon,fall_detected,unusual_activity
TELEGRAM_COOLDOWN_SECONDS=60
TELEGRAM_MIN_CONFIDENCE=0.50

# -----------------------------------------------------------------------------
# TTS Voice Siren Alerts (pyttsx3 - offline Windows SAPI)
# -----------------------------------------------------------------------------
TTS_ENABLED=true
TTS_VOICE_RATE=180
TTS_VOICE_VOLUME=1.0
# Event types that trigger voice alerts
TTS_ALERT_TYPES=fire_detected,smoke,violence,weapon,fight,assault,intrusion
# Siren duration and repeat count
SIREN_DURATION_SECONDS=10
SIREN_REPEAT_COUNT=3

# -----------------------------------------------------------------------------
# Dashboard Security
# -----------------------------------------------------------------------------
# Set a strong password if accessing from LAN/internet
DASHBOARD_PASSWORD=
# Multi-user access: set a strong admin password before creating client accounts.
ADMIN_USERNAME=admin
APP_TIMEZONE=Asia/Kolkata
ADMIN_PASSWORD=
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Allowed origins for WebSocket (comma-separated)
ALLOWED_ORIGINS=
# Additional specialist trained from supplied CCTV / Pascal VOC datasets.
TRAINED_WEAPON_MODEL_PATH=models/visionguard-weapon-trained.pt
# Keras 3DCNN is optional, requires TensorFlow and verified label polarity.
# On native Windows, recent TensorFlow builds do not support CUDA GPU; use WSL2 for TF CUDA.
CNN3D_MODEL_PATH=models/fight_detection_model.h5
ENABLE_3DCNN=false
CNN3D_POSITIVE_CLASS=
CNN3D_CONFIDENCE=0.75
CNN3D_EVERY_N_FRAMES=8

# Optional independently trained torch/torchvision video fight classifier.
# Train with labeled normal/fight video folders; separate from YOLO detection.
ENABLE_FIGHT_CLASSIFIER=false
FIGHT_CLASSIFIER_MODEL_PATH=models/visionguard-r3d18-fight.pt
FIGHT_CLASSIFIER_CONFIDENCE=0.85
FIGHT_CLASSIFIER_INTERVAL=8

# -----------------------------------------------------------------------------
# Multi-camera GPU resource controls (tune after measuring actual FPS/VRAM)
# -----------------------------------------------------------------------------
MAX_ACTIVE_CAMERAS=4
INFERENCE_PARALLELISM=1
SHARE_SPECIALIST_MODELS=true
# For small GPUs consider FRAME_SKIP=2 and WEAPON_EVERY_N_FRAMES=3,
# OBJECT_EVERY_N_FRAMES=5. All configured cameras remain in the dashboard.
# Store camera URLs in .env, NOT in committed cameras.json.
# CAMERA_GATE_RTSP=rtsp://username:password@192.168.1.100:554/Streaming/Channels/101
# CAMERA_WAREHOUSE_RTSP=rtsp://username:password@192.168.1.101:554/Streaming/Channels/101
# Train output is stored separately; enable only AFTER site holdout tests.
ENABLE_TRAINED_WEAPON_MODEL=false
